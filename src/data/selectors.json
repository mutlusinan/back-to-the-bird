{
  "sideNavLogo": [
    "header[role=\"banner\"] h1 a[href=\"/home\"]",
    "header[role=\"banner\"] h1"
  ],
  "primaryColumn": [
    "[data-testid=\"primaryColumn\"]"
  ],
  "sidebarColumn": [
    "[data-testid=\"sidebarColumn\"]"
  ],
  "sidebarBox": [
    "[data-testid=\"sidebarColumn\"] section[role=\"region\"], [data-testid=\"sidebarColumn\"] aside[role=\"complementary\"]",
    "[data-testid=\"sidebarColumn\"] section, [data-testid=\"sidebarColumn\"] aside"
  ],
  "radiusKeep": [
    "[data-testid=\"SearchBox_Search_Input_label\"], [data-testid=\"SearchBox_Search_Input_label\"] div, [role=\"switch\"], [role=\"switch\"] *"
  ],
  "navHome": [
    "[data-testid=\"AppTabBar_Home_Link\"]"
  ],
  "navExplore": [
    "[data-testid=\"AppTabBar_Explore_Link\"]"
  ],
  "navNotifications": [
    "[data-testid=\"AppTabBar_Notifications_Link\"]"
  ],
  "navMessages": [
    "[data-testid=\"AppTabBar_DirectMessage_Link\"]"
  ],
  "navProfile": [
    "[data-testid=\"AppTabBar_Profile_Link\"]"
  ],
  "navMore": [
    "[data-testid=\"AppTabBar_More_Menu\"]"
  ],
  "actionReply": [
    "article [data-testid=\"reply\"]"
  ],
  "actionRetweet": [
    "article :is([data-testid=\"retweet\"],[data-testid=\"unretweet\"])"
  ],
  "actionLike": [
    "article [data-testid=\"like\"]"
  ],
  "actionLiked": [
    "article [data-testid=\"unlike\"]"
  ],
  "actionBookmark": [
    "article :is([data-testid=\"bookmark\"],[data-testid=\"removeBookmark\"])"
  ],
  "avatar": [
    "[data-testid^=\"UserAvatar-Container-\"]"
  ],
  "followButton": [
    "[data-testid$=\"-follow\"]"
  ],
  "unfollowButton": [
    "[data-testid$=\"-unfollow\"]"
  ],
  "composeButton": [
    "[data-testid=\"SideNav_NewTweet_Button\"]"
  ],
  "composeSubmit": [
    ":is([data-testid=\"tweetButtonInline\"],[data-testid=\"tweetButton\"])"
  ],
  "grokNav": [
    "header[role=\"banner\"] nav a[href=\"/i/grok\"]"
  ],
  "grokDrawer": [
    "[data-testid=\"GrokDrawer\"]"
  ],
  "grokTweetButton": [
    "article div:has(> div > [data-testid=\"caret\"]) > div > button:not([data-testid])",
    "button[aria-label=\"Grok actions\"]"
  ],
  "premiumNav": [
    "[data-testid=\"premium-signup-tab\"]"
  ],
  "premiumSidebar": [
    "[data-testid=\"sidebarColumn\"] aside:has(a[href=\"/i/premium_sign_up\"]), [data-testid=\"primaryColumn\"] div:has(> button + div > a[href=\"/i/premium_sign_up\"])"
  ],
  "viewCount": [
    "article [role=\"group\"] a[href$=\"/analytics\"]"
  ],
  "wordComposeButton": [
    "[data-testid=\"SideNav_NewTweet_Button\"]"
  ],
  "wordComposeSubmit": [
    "[data-testid=\"primaryColumn\"]:not(:has([data-testid=\"inline_reply_offscreen\"])) [data-testid=\"tweetButtonInline\"], [role=\"dialog\"]:not(:has(article)) [data-testid=\"tweetButton\"]"
  ],
  "wordRepostAction": [
    "[data-testid=\"retweetConfirm\"]"
  ],
  "wordUndoRepostAction": [
    "[data-testid=\"unretweetConfirm\"]"
  ],
  "wordQuoteAction": [
    "[role=\"menu\"] a[role=\"menuitem\"][href=\"/compose/post\"]"
  ],
  "wordRepostsLabel": [
    "a[role=\"tab\"]:is([href$=\"/retweets\"], [href$=\"/reposts\"])"
  ],
  "wordQuotesLabel": [
    "a[role=\"tab\"][href$=\"/quotes\"]"
  ],
  "wordLikesLabel": [
    "a[role=\"tab\"][href$=\"/likes\"]"
  ],
  "wordProfilePostsTab": [
    "[data-testid=\"primaryColumn\"]:has([data-testid=\"UserName\"]) [role=\"tablist\"] [role=\"presentation\"]:first-child > a[role=\"tab\"]"
  ]
}
